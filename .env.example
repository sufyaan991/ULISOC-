# Copy to .env.local for development and add the same variables in Vercel.
# Never commit real values.

# Supabase → Project Settings → Database → Connection string.
# Runtime: transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations (npm run db:migrate): session pooler or direct connection (port 5432).
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Member sign-in (Supabase Auth). Supabase → Project Settings → API Keys.
# Only used on the server; never use the secret key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Keep false until migrations have run and the secrets below are set. Requires a redeploy to change.
NEXT_PUBLIC_DATABASE_FEATURES_ENABLED=false

# Application secrets (use the original values if importing existing records).
MEMBERSHIP_HMAC_SECRET=
DATA_ENCRYPTION_SECRET=
AUTH_SESSION_SECRET=
JUMMAH_EDITOR_PASSWORD=
JUMMAH_ADMIN_EMAILS=
# Legacy key, only needed to read records created before key separation.
JUMMAH_SESSION_SECRET=
